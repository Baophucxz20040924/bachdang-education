# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.xxxx.mongodb.net/education_ai

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES=7d

# CORS (frontend origin). For S3/CloudFront set the hosted URL.
CORS_ORIGIN=http://localhost:5173

# Reverse proxy: number of proxies in front of the app (Nginx = 1).
# Needed so rate limiting / req.ip use the real client IP. Set to 1 in production.
TRUST_PROXY=false

# AI provider: mock (default, no key needed) | gemini | openai | beeknoee
AI_PROVIDER=mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Beeknoee (OpenAI-compatible) — https://platform.beeknoee.com/docs
# Set AI_PROVIDER=beeknoee and provide the key below to enable.
# BEEKNOEE_API_KEY=sk-bee-...
# BEEKNOEE_BASE_URL=https://platform.beeknoee.com/v1
# BEEKNOEE_MODEL=deepseek/deepseek-v3.2
# BEEKNOEE_EMBED_MODEL=openai/text-embedding-3-small

# Knowledge base (PDF upload + RAG)
STORAGE_DRIVER=local          # local (default) | s3 (extension point)
MAX_UPLOAD_MB=20

# Seed default password (dev only)
SEED_DEFAULT_PASSWORD=matkhau123
